{
  "name": "claude-design-wedding-gift-list-fe",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "check-types": "npm run check-types --workspaces",
    "dev:web": "npm run dev --workspace web",
    "db:push": "npm run db:push --workspace @claude-design-wedding-gift-list-fe/db",
    "db:studio": "npm run db:studio --workspace @claude-design-wedding-gift-list-fe/db",
    "db:generate": "npm run db:generate --workspace @claude-design-wedding-gift-list-fe/db",
    "db:migrate": "npm run db:migrate --workspace @claude-design-wedding-gift-list-fe/db",
    "db:local": "npm run db:local --workspace @claude-design-wedding-gift-list-fe/db",
    "generate:images": "node scripts/generate-images.mjs",
    "generate:image": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@claude-design-wedding-gift-list-fe/env": "*",
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@claude-design-wedding-gift-list-fe/config": "*",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^22.13.14",
    "typescript": "^6"
  },
  "packageManager": "npm@11.11.0"
}
